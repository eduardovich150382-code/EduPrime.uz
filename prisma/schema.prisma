generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== USERS & AUTH =====================

enum UserRole {
  USER
  TEACHER
  ADMIN
}

model User {
  id                String   @id @default(cuid())
  name              String?
  email             String?  @unique
  emailVerified     DateTime?
  image             String?
  telegramId        String?  @unique
  telegramUsername  String?
  googleId          String?  @unique
  role              UserRole @default(USER)
  lang              String   @default("uz")
  referralCode      String?  @unique
  referredBy        String?
  lastActiveAt      DateTime?
  isBanned          Boolean  @default(false)
  bannedReason      String?
  masteryMapFreeViewedAt DateTime? // Bepul tarif uchun Bilim xaritasidan oxirgi foydalanish vaqti — oyiga 1 marta (lib/date.ts#daysSince orqali tekshiriladi)
  dtmOnlineFreeUsedAt    DateTime? // Bepul tarif uchun DTM Online'dan oxirgi foydalanish vaqti — oyiga 1 marta (lib/date.ts#daysSince orqali tekshiriladi)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  accounts          Account[]
  sessions          Session[]
  teacher           Teacher?
  subscriptions     Subscription[]
  permissions       UserPermission[]
  testResults       TestResult[]
  payments          Payment[]
  confirmedPayments Payment[]    @relation("ConfirmedBy")
  referralsMade     Referral[]   @relation("ReferralsMade")
  referralsReceived Referral[]   @relation("ReferralsReceived")
  notifications     Notification[]
  generatedTests    Test[]       @relation("GeneratedTests")
  testSessions      TestSession[]
  courseEnrollments CourseEnrollment[]
  lessonProgress    LessonProgress[]
  courseReviews     CourseReview[]
  purchases         Purchase[]
  dailyUsage        DailyUsage[]
}

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referredUserId String
  createdAt      DateTime @default(now())

  referrer     User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferralsReceived", fields: [referredUserId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================== TEACHERS =====================

model Teacher {
  id         String   @id @default(cuid())
  userId     String   @unique
  subjectId  String
  bio        String?
  verified   Boolean  @default(false)
  rating     Float    @default(0)
  createdAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  tests   Test[]
  bankQuestions BankQuestion[]
  courses Course[]
}

// ===================== SUBJECTS & CATEGORIES =====================

enum TestType {
  DTM
  SCHOOL
  ATTESTATION
  SAT
  GRE
  CERTIFICATE
  PRESIDENT_SCHOOL
}

enum PlanType {
  FREE
  PREMIUM
  TEACHER_PLAN
}

model TestCategory {
  id           String   @id @default(cuid())
  nameUz       String
  nameRu       String
  nameEn       String
  type         TestType
  requiredPlan PlanType @default(PREMIUM)
  icon         String?
  description  String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  subjects Subject[]
  permissions UserPermission[]
}

model Subject {
  id         String   @id @default(cuid())
  nameUz     String
  nameRu     String
  nameEn     String
  icon       String?
  categoryId String
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  category TestCategory @relation(fields: [categoryId], references: [id])
  teachers Teacher[]
  tests    Test[]
  bankQuestions BankQuestion[]
  courses  Course[]
  topics   TopicNode[]
  items    Item[]

  @@index([categoryId, order])
}

// Ierarxik mavzu daraxti. `Question.topic` (erkin matn) o'rnini bosmaydi —
// bu ustunga hali tegilmagan, bog'lanish keyingi sessiyada qilinadi. Hozircha
// faqat daraxtning o'zi: DTM Online generatori va bilim xaritasi kelajakda
// erkin "topic" matni o'rniga shu daraxtdagi tugunga (path) ishora qiladi,
// shunda "Kinematika" va "kinematika" endi ikki xil mavzu bo'lib qolmaydi.
model TopicNode {
  id        String  @id @default(cuid())
  subjectId String
  parentId  String?
  slug      String
  path      String   // "mexanika/kinematika/erkin-tushish"
  level     Int      @default(0)
  nameUz    String
  nameRu    String?
  nameEn    String?
  aliases   String[] @default([]) // muqobil nomlar — savol teglarini bog'lashda nameUz bilan bir qatorda hisobga olinadi
  grade     Int[]    @default([])
  order     Int      @default(0)
  createdAt DateTime @default(now())

  subject  Subject     @relation(fields: [subjectId], references: [id])
  parent   TopicNode?  @relation("TopicTree", fields: [parentId], references: [id])
  children TopicNode[] @relation("TopicTree")
  items    ItemTopic[]

  @@unique([subjectId, slug])
  @@index([path])
  @@index([subjectId, level, order])
}

// ===================== TESTS & QUESTIONS =====================

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_ENDED
  TRUE_FALSE
  MULTI_SELECT
  FILL_BLANK
  MATCHING
}

model Test {
  id              String       @id @default(cuid())
  titleUz         String
  titleRu         String?
  titleEn         String?
  categoryId      String
  subjectId       String
  teacherId       String?
  userId          String?      // Faqat dasturiy generatsiya qilingan testlar uchun (masalan DTM Online) — egasi va "shaxsiy/generatsiya qilingan" belgisi
  price           Int          @default(0)
  isFree          Boolean      @default(false)
  accessType      String       @default("free") // free, premium, teacher, premium_teacher, paid
  duration        Int          // in minutes
  questionCount   Int
  format          QuestionType @default(MULTIPLE_CHOICE)
  difficulty      Int          @default(1) // 1-5
  coverImage      String?      // Cover image URL
  videoSolution   String?      // URL
  writtenSolution String?      // LaTeX text
  isPublished     Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subject   Subject       @relation(fields: [subjectId], references: [id])
  teacher   Teacher?      @relation(fields: [teacherId], references: [id])
  user      User?         @relation("GeneratedTests", fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]
  testItems TestItem[]
  results   TestResult[]
  courseLessons CourseLesson[]
  lessonBlocks  LessonBlock[]

  @@index([subjectId, isPublished])
  @@index([categoryId, isPublished])
  @@index([userId])
}

model Question {
  id                 String       @id @default(cuid())
  testId             String
  text               String       // LaTeX supported
  images             String[]     // Array of image URLs for question
  options            Json         // [{label, text, image}] — A,B,C,D,E (E optional)
  correctAnswer      String       // "A", "B", "C", "D", "E" or open text
  type               QuestionType @default(MULTIPLE_CHOICE)
  explanation        String?      // LaTeX written solution
  explanationImages  String[]     // Images in explanation
  videoUrl           String?      // Video solution URL
  aiExplanations     Json?        // AI tutor explanation cache, keyed by lang: {uz, ru, en}
  topic              String?      // Mavzu tegi, masalan: "Kvadrat tenglama"
  bloomLevel         String?      // BILISH, TUSHUNISH, QOLLASH, TAHLIL, BAHOLASH, YARATISH
  difficulty         Int?         // 1 (oson) - 5 (qiyin), ixtiyoriy — DTM Online balanslashda ishlatiladi
  subjectId          String?      // Faqat generatsiya qilingan (masalan DTM Online) savollarda — bo'lim tegi
  points             Float        @default(1) // Float — DTM Online kabi qismli ball (3.1/2.1/1.1) uchun
  order              Int          @default(0)
  createdAt          DateTime     @default(now())

  // --- Parametrik savol generatori (lib/paramgen) uchun maydonlar ---
  templateId         String?      // Generator shabloni id'si, masalan "fiz-kinematika-erkin-tushish-01"
  variantSig         String?      @unique // Shu shablon+parametrlar kombinatsiyasi imzosi — qayta seed qilinganda dublikatning oldini oladi
  subtopic           String?
  grade              Int[]        @default([])
  exams              String[]     @default([]) // "dtm", "maktab", "milliy" va h.k.
  lang               String       @default("uz")
  hints              String[]     @default([])
  tags               String[]     @default([])
  source             String       @default("manual") // "manual" | "parametric"

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([testId, order])
  @@index([topic])
  @@index([subjectId])
}

// Savollar bazasi — o'qituvchi yozgan savol testdan mustaqil, qayta-qayta
// ko'p testga (nusxa sifatida) qo'shilishi mumkin. Mavjud Question/Test
// bog'lanishiga tegilmagan — shuning uchun bu qo'shimcha, xavfsiz jadval.
model BankQuestion {
  id                String       @id @default(cuid())
  teacherId         String
  subjectId         String
  text              String
  images            String[]
  options           Json
  correctAnswer     String
  type              QuestionType @default(MULTIPLE_CHOICE)
  explanation       String?
  explanationImages String[]
  topic             String?
  bloomLevel        String?
  difficulty        Int?         // 1 (oson) - 5 (qiyin), ixtiyoriy
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@index([teacherId, subjectId])
  @@index([topic])
}

// ===================== ITEM (kanonik savol banki) =====================
// Kelajakda Question va BankQuestion o'rnini bosadigan yagona savol modeli.
// Hozircha faqat sxema — mavjud Question/BankQuestion oqimlariga tegilmagan,
// ular ustidan hech narsa ko'chirilmagan. legacyQuestionId/legacyBankId eski
// yozuvlar bilan keyingi backfill'ni kuzatish uchun.
enum ItemStatus {
  DRAFT
  REVIEW
  PUBLISHED
  RETIRED
}

enum ItemSource {
  MANUAL
  PARAMETRIC
  AI
}

enum ItemVisibility {
  PUBLIC
  PRIVATE
}

enum ExplanationSource {
  AUTHORED
  AI
  NONE
}

model Item {
  id                String   @id @default(cuid())
  authorTeacherId   String?
  orgId             String?              // B2B uchun — hozir doim null
  subjectId         String
  text              String
  images            String[] @default([])
  options           Json
  correctAnswer     String
  type              QuestionType @default(MULTIPLE_CHOICE)
  explanation       String?
  explanationImages String[] @default([])
  explanationSource ExplanationSource @default(NONE)
  videoUrl          String?
  grade             Int[]    @default([])
  exams             String[] @default([])
  bloomLevel        String?
  difficulty        Int?
  pValue            Float?
  tags              String[] @default([])
  lang              String   @default("uz")
  source            ItemSource @default(MANUAL)
  status            ItemStatus @default(PUBLISHED)
  visibility        ItemVisibility @default(PRIVATE)
  templateId        String?
  variantSig        String?  @unique
  legacyQuestionId  String?  @unique   // backfill kuzatuvi uchun
  legacyBankId      String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subject      Subject             @relation(fields: [subjectId], references: [id])
  topics       ItemTopic[]
  testItems    TestItem[]
  stat         ItemStat?
  explanations ItemExplanation[]

  @@index([subjectId, status, visibility])
  @@index([subjectId, difficulty])
  @@index([templateId])
}

// AI repetitor tushuntirishlari keshi (S19). Faqat `Item.explanationSource
// === NONE` (mualliflik yozma/video yechimi yo'q) savollar uchun to'ldiriladi
// — AI mualliflik kontentining o'rnini bosmaydi, uning bo'shlig'ini
// to'ldiradi (qarang POST /api/results/[id]/ai-explain). `forAnswer` —
// talaba tanlagan (noto'g'ri) javob; to'g'ri javob YOKI javob berilmagan
// (o'tkazib yuborilgan) holat uchun bo'sh satr (`""`), `null` EMAS —
// Postgres unique indeksida NULL qiymatlar bir-biriga teng emas, shuning
// uchun `null` ishlatilsa `@@unique` shu eng ko'p uchraydigan holatni
// (to'g'ri javob/skip) TAKRORLANISHDAN UMUMAN HIMOYA QILMAS EDI. Bo'sh satr
// esa oddiy qiymat sifatida cheklovni to'liq ishlatadi. Shu sababli bitta
// savolga har xil noto'g'ri javob bergan ikki talaba ikki xil, ularning
// aynan xatosiga qaratilgan tushuntirish oladi.
model ItemExplanation {
  id         String    @id @default(cuid())
  itemId     String
  lang       String
  forAnswer  String    @default("")
  text       String
  upvotes    Int       @default(0)
  downvotes  Int       @default(0)
  promotedAt DateTime?
  createdAt  DateTime  @default(now())

  item  Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  votes ExplanationVote[]

  @@unique([itemId, lang, forAnswer])
  @@index([itemId, lang])
}

// Bitta foydalanuvchi bitta tushuntirishga faqat BIR MARTA ovoz beradi
// (S20a). Ovoz o'zgartirilishi mumkin (👍 dan 👎 ga) — shu vaqtda
// `ItemExplanation.upvotes`/`downvotes` bitta tranzaksiyada mos ravishda
// yangilanadi (qarang POST /api/explanations/[id]/vote). `userId` ataylab
// FK emas — `SolutionUnlock`dagi bilan bir xil naqsh (schema.prisma'dagi
// shu model izohiga qarang).
model ExplanationVote {
  userId        String
  explanationId String
  value         Int // +1 yoki -1
  createdAt     DateTime @default(now())

  explanation ItemExplanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@id([userId, explanationId])
}

model ItemTopic {
  itemId  String
  topicId String
  weight  Float @default(1)

  item  Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  topic TopicNode @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([itemId, topicId])
  @@index([topicId])
}

model TestItem {
  testId String
  itemId String
  order  Int   @default(0)
  points Float @default(1)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id])

  @@id([testId, itemId])
  @@index([testId, order])
}

model ItemStat {
  itemId         String @id
  attempts       Int    @default(0)
  correct        Int    @default(0)
  pValue         Float?
  discrimination Float?
  avgTimeSec     Float?
  distractorHits Json?
  updatedAt      DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

// ===================== COURSES (kurs yaratish, MVP-A: sxema + muallif tomoni) =====================

enum LessonType {
  VIDEO
  TEXT
  QUIZ
  PDF
}

model Course {
  id             String   @id @default(cuid())
  titleUz        String
  titleRu        String?
  titleEn        String?
  description    String?
  coverImage     String?
  teacherId      String
  subjectId      String
  accessType     String   @default("free") // free, premium, teacher, premium_teacher, paid — Test bilan bir xil
  price          Int      @default(0)
  isFree         Boolean  @default(false)
  isPublished    Boolean  @default(false)
  difficulty     Int?     // 1-5, ixtiyoriy
  estimatedHours Float?
  sequentialUnlock Boolean @default(false) // yoqilsa, dars faqat oldingi dars "o'tilgan" bo'lsagina ochiladi
  trailerVideoUrl String?  // YouTube tanishtiruv videosi — landing hero'da SecureYouTubePlayer orqali
  whatYoullLearn  String[] @default([]) // "Nimani o'rganasiz" belgili ro'yxati
  prerequisites   String?  // "Kimlar uchun / oldindan talab qilinadigan bilim" — erkin matn
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher     Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id])
  sections    CourseSection[]
  enrollments CourseEnrollment[]
  reviews     CourseReview[]
}

model CourseSection {
  id        String   @id @default(cuid())
  courseId  String
  titleUz   String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]
}

model CourseLesson {
  id              String     @id @default(cuid())
  sectionId       String
  titleUz         String
  order           Int        @default(0)
  type            LessonType @default(VIDEO)
  videoUrl        String?    // YouTube — SecureYouTubePlayer orqali ko'rsatiladi
  content         String?    // LaTeX/matn — LatexRenderer qayta ishlatiladi
  testId          String?    // MAVJUD Test'ga ishora — QUIZ turi uchun, qayta qurilmaydi
  fileUrl         String?    // PDF turi uchun — /api/upload?endpoint=aiImportFile orqali yuklanadi
  minPassPercent  Int?       // Faqat QUIZ turi uchun — sequentialUnlock yoqilgan kursda keyingi darsni ochish uchun talab qilinadigan minimal ball foizi
  durationMinutes Int?
  isPreviewable   Boolean    @default(false) // yozilmagan foydalanuvchi ham ko'ra oladigan bepul namuna (MVP-B)
  checkpoints     Json?      // S23 — VIDEO turi dars uchun video nazorat nuqtalari: [{ atSeconds, itemId }], qarang lib/video-checkpoints.ts
  createdAt       DateTime   @default(now())

  section  CourseSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  test     Test?            @relation(fields: [testId], references: [id])
  progress LessonProgress[]
  blocks   LessonBlock[]

  @@index([sectionId, order])
}

// Darsning asosiy kontentiga (yuqoridagi type/videoUrl/content/testId/fileUrl)
// QO'SHIMCHA ravishda biriktiriladigan ixtiyoriy materiallar — fayl(lar),
// qo'shimcha mashq testi, video-yechim. Ataylab alohida jadval: asosiy dars
// maydonlariga hech qanday ta'sir qilmaydi, shu sababli eski (bloksiz)
// darslar butunlay o'zgarishsiz qoladi. Sof qo'shimcha material — dars
// tugatish/qulflash (LessonProgress, course-lock.ts, creditQuizLessonProgress)
// mantig'iga umuman ta'sir qilmaydi.
// EMBED va PRACTICE — S22b. `embedUrl`/`itemIds` qo'shilishi Postgres enum
// qiymat qo'shish + ishlatishni bitta tranzaksiyada qila olmasligi bilan
// bog'liq emas (bular oddiy nullable ustunlar) — cheklov faqat ENUM
// qiymatlarining o'ziga tegishli (qarang shu migratsiya papkasidagi izoh).
enum LessonBlockType {
  FILE
  QUIZ
  VIDEO_SOLUTION
  EMBED
  PRACTICE
}

model LessonBlock {
  id              String          @id @default(cuid())
  lessonId        String
  type            LessonBlockType
  order           Int             @default(0)
  labelUz         String?         // Ko'rinadigan nom (masalan "Mashq varag'i"); bo'sh bo'lsa turga qarab standart nom ishlatiladi
  fileUrl         String?         // FILE
  videoUrl        String?         // VIDEO_SOLUTION
  testId          String?         // QUIZ — mavjud Test'ga ishora (CourseLesson.testId bilan bir xil naqsh)
  revealAfterQuiz Boolean         @default(false) // VIDEO_SOLUTION — true bo'lsa, foydalanuvchi shu darsning QUIZ blokini (yoki dars testId'sini) topshirmaguncha GET /api/courses/[id]/learn videoUrl'ni null qaytaradi (qulflangan dars bilan bir xil naqsh)
  embedUrl        String?         // EMBED — tashqi simulyatsiya havolasi; ruxsat etilgan domenlar src/lib/embed-allowlist.ts da, SERVER tomonda ham tekshiriladi (qarang PUT /api/teacher/courses/[id]/curriculum)
  itemIds         String[]        @default([]) // PRACTICE — Item.id lar (baholanmaydigan mashq havzasi); FK EMAS, TestSession.itemIds bilan bir xil naqsh
  checkpoints     Json?           // S23 — VIDEO_SOLUTION bloki uchun video nazorat nuqtalari; CourseLesson.checkpoints bilan bir xil shakl, qarang lib/video-checkpoints.ts
  createdAt       DateTime        @default(now())

  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  test   Test?        @relation(fields: [testId], references: [id])

  @@index([lessonId, order])
}

model CourseEnrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  lessonId            String
  completed           Boolean   @default(false)
  lastPositionSeconds Int?
  bestScorePercent    Int?      // QUIZ darsi uchun — eng yaxshi urinishning ball foizi
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ===================== VIRTUAL TEST SESSIONS =====================
// Har generatsiya qilingan test (DTM Online, mashq testi) uchun bazaga
// o'nlab Question qatori yozish o'rniga — ItemSpec + tanlangan Item id'lari
// (itemIds) saqlanadi, savollarning o'zi Item jadvalidan so'rov vaqtida
// olinadi. `itemIds` ataylab oddiy String[] (Item'ga FK emas) — bu faqat
// ishoralar ro'yxati, Item o'chirilsa ham TestSession buzilmaydi (savol
// shunchaki natijada ko'rinmay qoladi). `seed` — GET/submit ikkalasida bir
// xil aralashtirish tartibini qayta hosil qilish uchun (baseSeed o'rniga
// generateSeed(userId, id) emas, shu saqlangan qiymat ishlatiladi — chunki
// bitta foydalanuvchi bir xil spec bilan bir nechta sessiya ochishi mumkin,
// ularning har biri BOSHQA aralashtirishga ega bo'lishi kerak).
enum SessionMode {
  FIXED
  ADAPTIVE
}

model TestSession {
  id          String      @id @default(cuid())
  userId      String
  title       String
  spec        Json        // ItemSpec — qayta ishlatish va ulashish uchun
  itemIds     String[]    // tanlangan savollar — faqat ishoralar (Item.id), FK emas
  seed        Int
  mode        SessionMode @default(FIXED)
  durationMin Int
  startedAt   DateTime    @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  results TestResult[]

  @@index([userId, startedAt])
}

// ===================== RESULTS =====================

model TestResult {
  id          String   @id @default(cuid())
  userId      String
  testId      String?      // Sessiya orqali topshirilgan natijada bo'sh — sessionId to'ldirilgan bo'ladi
  sessionId   String?      // TestSession orqali topshirilgan natijada to'ldirilgan (haqiqiy Test qatori yo'q)
  score       Int
  maxScore    Int
  percentage  Float
  answers     Json     // [{questionId, answer, isCorrect, timeSpent}]
  timeSpent   Int      // in seconds
  completedAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    Test?        @relation(fields: [testId], references: [id])
  session TestSession? @relation(fields: [sessionId], references: [id])

  @@index([userId, completedAt])
  @@index([testId])
  @@index([sessionId])
}

// ===================== SUBSCRIPTIONS & PAYMENTS =====================

enum SubscriptionPlan {
  PREMIUM
  TEACHER_PLAN
}

enum SubscriptionDuration {
  ONE_MONTH
  THREE_MONTHS
  SIX_MONTHS
  ONE_YEAR
}

model Subscription {
  id        String               @id @default(cuid())
  userId    String
  plan      SubscriptionPlan
  duration  SubscriptionDuration
  startDate DateTime             @default(now())
  endDate   DateTime
  isActive  Boolean              @default(true)
  paymentId String?              @unique
  createdAt DateTime             @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([userId, isActive, endDate])
}

model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  grantedBy  String?  // Admin who granted
  expiresAt  DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category TestCategory @relation(fields: [categoryId], references: [id])

  @@unique([userId, categoryId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model Payment {
  id               String               @id @default(cuid())
  userId           String
  plan             SubscriptionPlan
  duration         SubscriptionDuration
  amount           Int
  status           PaymentStatus        @default(PENDING)
  receiptPhoto     String?              // Uploaded receipt image URL
  telegramMsgId    String?              // Telegram message ID
  confirmedById    String?              // Admin who confirmed
  confirmedAt      DateTime?
  selectedSubjects String[]             // For TEACHER_PLAN — selected subject IDs
  createdAt        DateTime             @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmedBy User?         @relation("ConfirmedBy", fields: [confirmedById], references: [id])
  subscription Subscription?

  @@index([userId, status])
}

// `Payment.selectedSubjects` asli TEACHER_PLAN uchun tanlangan fan id'larini
// saqlash uchun mo'ljallangan edi, lekin bitta-test/bitta-kurs xaridini ham
// shu maydonga (test/kurs id'sini) tiqib qo'yish orqali "vaqtinchalik"
// kengaytirilgan (lib/access.ts, telegram/webhook confirm_ handler) —
// natijada bitta massivda fan id'lari va xarid id'lari aralashadi. Purchase
// bitta xaridni bitta aniq turga (itemType) bog'laydi, shuning uchun
// checkTestAccess/checkCourseAccess endi buni ANIQ tekshira oladi.
// `selectedSubjects` orqali tekshirish CLAUDE.md talabiga ko'ra zaxira
// sifatida saqlanadi — backfill prod'da bajarilmaguncha eski xaridlar ham
// ishlayveradi.
model Purchase {
  id        String   @id @default(cuid())
  userId    String
  itemType  String   // "test" | "course"
  itemId    String
  paymentId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
  @@index([userId, itemType])
}

// ===================== NOTIFICATIONS =====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ===================== KVOTA VA YECHIM DARAJALARI (S17) =====================
// Bepul foydalanuvchi uchun kunlik cheklovlar (test tuzish, yechim ochish
// va h.k.) va qaysi savol yechimi ochilganini kuzatish. Kun — Tashkent
// kalendar kuni (lib/date.ts#tashkentDateKey), UTC emas — lib/quota.ts
// shu qiymatdan `date` ustunini to'ldiradi.

model DailyUsage {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @db.Date   // Asia/Tashkent kuni, UTC emas
  builtTests        Int      @default(0)
  dtmOnline         Int      @default(0)
  solutionsUnlocked Int      @default(0)
  tutorMessages     Int      @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// `itemId` — Question.id (haqiqiy Test orqali) YOKI Item.id (TestSession
// orqali) bo'lishi mumkin, ataylab FK emas — TestSession.itemIds bilan bir
// xil naqsh (ikkala manbani ham qamrab olish uchun), ikkala id fazosi ham
// cuid/uuid bo'lgani sababli to'qnashuv amalda bo'lmaydi.
model SolutionUnlock {
  userId     String
  itemId     String
  unlockedAt DateTime @default(now())

  @@id([userId, itemId])
  @@index([userId, unlockedAt])
}

// ===================== SYSTEM SETTINGS =====================

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
