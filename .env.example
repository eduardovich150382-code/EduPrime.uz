# Database
DATABASE_URL="postgresql://user:password@localhost:5432/eduprime?schema=public"

# NextAuth / Auth.js v5
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"
AUTH_SECRET="your-secret-key-here"
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram Bot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="EduPrimeuzbot"
TELEGRAM_WEBHOOK_SECRET="" # random string; verifies incoming webhook requests really come from Telegram

# Cron jobs (Vercel Cron / external scheduler) — required to call /api/cron/*
CRON_SECRET=""

# One-time admin bootstrap (/api/admin/setup, /api/admin/seed) — set a random value, not a guessable word
ADMIN_SETUP_SECRET=""

# Cloudinary (for images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AI (Gemini - free tier)
GEMINI_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_TELEGRAM_IDS="" # comma separated admin telegram IDs
PAYMENT_CARD_NUMBER="" # card number for payments
